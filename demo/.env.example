# Copy to .env. Keep credentials empty until configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
APP_SESSION_SECRET=
AUTH_REQUIRED=false
APP_PUBLIC_URL=http://localhost:8000
S19_ADAPTER_ENABLED=0
